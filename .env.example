# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only multi-model AI Insights configuration.
# Every provider with a key is consulted in parallel. The first provider in
# AI_PROVIDERS consolidates successful responses into one staff-facing report.
# Never prefix any API key with NEXT_PUBLIC_.
AI_PROVIDERS=groq,gemini,openrouter,deepseek

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# Backward-compatible single-provider configuration is also supported:
# AI_PROVIDER=groq
# AI_API_KEY=your_provider_api_key
# AI_MODEL=llama-3.1-8b-instant
# Comma-separated individual addresses and/or an approved domain wildcard.
FUTURE_PLUS_STAFF_EMAILS=admin@futureplusedus.com,counsellor@gmail.com,*@futureplusedus.com
FUTURE_PLUS_SUPER_USER_EMAILS=admin@futureplusedus.com
# Server-only Supabase key used to synchronise Staff/Super User roles after Google login.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
